# Kopiere diese Datei nach .env.local und trage die Werte aus dem Supabase-Dashboard ein
# (Project Settings -> API).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# KI-Import (PDF -> Karteikarten / Probeprüfung). Nur serverseitig, nie mit NEXT_PUBLIC_ versehen.
# In Vercel als Environment Variable eintragen. Optional: ANTHROPIC_MODEL überschreibt das Standardmodell.
ANTHROPIC_API_KEY=sk-ant-...
